{
  "spec_section": "3",
  "argon_param_version": "argon2id-v1",
  "_comment": "Frozen vectors, REGENERATED from the real modules (src/identity.ts canonical + reference/identity.py), verified byte-identical cross-language. Hashed-factor inputs are given as 'sha256_of' preimages so both languages reproduce the digest. Regenerate ONLY via gen_vectors + a reviewed parity run.",
  "vectors": [
    {
      "name": "strong-mixed-factors",
      "note": "One know + three hashed factors. Clears the 128-bit measured floor and the diversity rule. The canonical positive vector.",
      "param_version": "argon2id-v1",
      "factors": [
        {
          "class": "know",
          "text": "correct horse battery staple plenitude"
        },
        {
          "class": "have",
          "sha256_of": "yubikey-secret",
          "declared_bits": 64,
          "provenance": "yubikey-hmac"
        },
        {
          "class": "who",
          "sha256_of": "recovery-contact",
          "declared_bits": 64,
          "provenance": "ssi-vc"
        },
        {
          "class": "are",
          "sha256_of": "fingerprint-template",
          "declared_bits": 24,
          "provenance": "fido2-prf"
        }
      ],
      "expected": {
        "locator_hash_hex": "84b233a03de4be013f99b52f01148589",
        "signing_public_hex": "1bcfa3505758c7cd368769dd31bd28b46da60f02ca7055ff498a87c6678ce32f",
        "encryption_public_hex": "f0ea306c454861cc8763fffe778694f81d8acb0041db6893206241bf48c05a00"
      }
    },
    {
      "name": "ordering-sensitivity",
      "note": "Same factors as strong-mixed-factors, reordered. MUST produce a DIFFERENT identity (order is part of the secret, SPEC 3.6).",
      "param_version": "argon2id-v1",
      "factors": [
        {
          "class": "have",
          "sha256_of": "yubikey-secret",
          "declared_bits": 64,
          "provenance": "yubikey-hmac"
        },
        {
          "class": "know",
          "text": "correct horse battery staple plenitude"
        },
        {
          "class": "are",
          "sha256_of": "fingerprint-template",
          "declared_bits": 24,
          "provenance": "fido2-prf"
        },
        {
          "class": "who",
          "sha256_of": "recovery-contact",
          "declared_bits": 64,
          "provenance": "ssi-vc"
        }
      ],
      "expected": {
        "locator_hash_hex": "55e8e4eea47216155f2ea3c5a570cb43",
        "signing_public_hex": "64586eb3e9f996d1811c38e8bda6ea2ea6d36bb96a7bda88a61750ea2003cdd0",
        "encryption_public_hex": "aa7d297a4e8e968e7fe1b64c4be84efbe2d5eee2058193fd0f59512299392d0a"
      },
      "must_differ_from": "strong-mixed-factors"
    },
    {
      "name": "passphrase-only-below-floor",
      "note": "The book's weakest config: four mediocre words, measured. Under zxcvbn this does NOT clear 128 bits and derivation MUST be refused (SPEC 3.2). Replaces the earlier vector that wrongly let this succeed.",
      "param_version": "argon2id-v1",
      "factors": [
        {
          "class": "know",
          "text": "Nebula"
        },
        {
          "class": "know",
          "text": "77"
        },
        {
          "class": "know",
          "text": "Correct"
        },
        {
          "class": "know",
          "text": "Horse"
        }
      ],
      "expected": {
        "throws": true,
        "error_contains": "entropy"
      }
    },
    {
      "name": "diversity-violation",
      "note": "Clears the raw 128-bit sum but one factor supplies more than half. MUST be refused by the diversity rule (SPEC 3.2).",
      "param_version": "argon2id-v1",
      "factors": [
        {
          "class": "know",
          "text": "correct horse battery staple plenitude"
        },
        {
          "class": "have",
          "sha256_of": "single-big-token",
          "declared_bits": 64,
          "provenance": "hw"
        },
        {
          "class": "who",
          "sha256_of": "tiny-1",
          "declared_bits": 2,
          "provenance": "vc"
        },
        {
          "class": "are",
          "sha256_of": "tiny-2",
          "declared_bits": 2,
          "provenance": "prf"
        }
      ],
      "expected": {
        "throws": true,
        "error_contains": "half"
      }
    }
  ]
}
